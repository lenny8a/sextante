    "viewsWelcome": [
      {
        "view": "abapNavigator.sistemas",
        "contents": "Sextante necesita la extensión de SAP ABAP Development Tools.\n[Instalar ABAP Development Tools](command:workbench.extensions.search?%22sapse.adt-vscode%22)",
        "when": "!abapNavigator.oficialInstalada"
      },
      {
        "view": "abapNavigator.sistemas",
        "contents": "No hay sistemas configurados.\n[Nuevo sistema](command:abapNavigator.sistemas.nuevo)",
        "when": "abapNavigator.oficialInstalada && abapNavigator.sinDestinos"
      },
      {
        "view": "abapNavigator.objeto",
        "contents": "Abre un objeto ABAP para ver su estructura.\n[Buscar objeto](command:abapNavigator.buscar)\n[Abrir por URI](command:abapNavigator.objeto.abrir)",
        "when": "!abapNavigator.objetoAbierto"
      },
      {
        "view": "abapNavigator.paquetes",
        "contents": "Marca un sistema como activo para explorar sus paquetes.\n[Elegir sistema](command:abapNavigator.sistemas.marcarActivo)",
        "when": "abapNavigator.paquetesSinSistema"
      },
      {
        "view": "abapNavigator.paquetes",
        "contents": "Conecta primero al sistema activo.\n[Conectar](command:abapNavigator.paquetes.conectar)",
        "when": "abapNavigator.paquetesSinConexion"
      }
    ],
    "configuration": {
      "title": "Sextante",
      "properties": {
        "abapNavigator.ia.servidor": {
          "type": "boolean",
          "default": true,
          "description": "Arranca el servidor MCP local que permite a un agente de IA trabajar con Sextante."
        },
        "abapNavigator.ia.puerto": {
          "type": "integer",
          "default": 2237,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Puerto local (127.0.0.1) del servidor MCP del agente."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "sextante.primerosPasos",
        "title": "Primeros pasos con Sextante",
        "description": "Navega, entiende y cambia código ABAP como en SE80, sin salir de VS Code.",
        "steps": [
          {
            "id": "conectar",
            "title": "Conecta un sistema",
            "description": "Sextante usa los sistemas de la extensión oficial de SAP. Indica una vez el rol de cada uno (DEV, QAS o PRD) y conéctate con tu usuario.\n[Abrir Sextante](command:workbench.view.extension.abapNavigator)",
            "media": {
              "image": "media/tutorial/01-panel.png",
              "altText": "Panel de Sextante con la lista de sistemas, las acciones y los paquetes"
            },
            "completionEvents": [
              "onView:abapNavigator.sistemas"
            ]
          },
          {
            "id": "buscar",
            "title": "Busca un objeto",
            "description": "Programas, clases, includes, tablas, módulos de funciones y transacciones por nombre, como en SE80.\n[Buscar objeto](command:abapNavigator.buscar)",
            "media": {
              "image": "media/tutorial/02-buscar.png",
              "altText": "Búsqueda rápida de objetos con los resultados de un programa y sus includes"
            },
            "completionEvents": [
              "onCommand:abapNavigator.buscar"
            ]
          },
          {
            "id": "objeto",
            "title": "Recorre su estructura",
            "description": "La vista Objeto muestra includes, clases locales, métodos y eventos. Un clic lleva al código; Ctrl+clic sobre un PERFORM salta a su FORM.",
            "media": {
              "image": "media/tutorial/03-objeto.png",
              "altText": "Árbol del objeto con includes, clases locales y métodos"
            },
            "completionEvents": [
              "onView:abapNavigator.objeto"
            ]
          },
          {
            "id": "acciones",
            "title": "Actúa con un clic",
            "description": "Activar, Activar todo, Verificar sintaxis, ATC, Unit tests, transporte, versiones y comparar con otro sistema: los comandos de la extensión oficial, siempre a la vista. En QAS y PRD el código queda en solo lectura.",
            "media": {
              "image": "media/tutorial/05-acciones.png",
              "altText": "Vista Acciones con los grupos Desarrollo, Transporte, Versiones y Herramientas"
            },
            "completionEvents": [
              "onView:abapNavigator.acciones"
            ]
          },
          {
            "id": "diccionario",
            "title": "El diccionario en contexto",
            "description": "Pasa el ratón sobre una tabla o un campo para ver su estructura sin salir del código. El panel Diccionario genera TYPES, SELECT y DATA. Necesita la conexión RFC.",
            "media": {
              "image": "media/tutorial/04-diccionario-hover.png",
              "altText": "Ventana emergente con los campos de la tabla T001 sobre un SELECT"
            },
            "completionEvents": [
              "onView:abapNavigator.diccionario"
            ]
          },
          {
            "id": "agente",
            "title": "Trabaja con un agente de IA",
            "description": "Sextante trae un servidor MCP local para Claude Code u otro agente: lee el código, propone cambios como un diff que tú aplicas o rechazas, verifica la sintaxis y pasa el ATC. Activar solo en DEV y con tu confirmación.\n[Conectar el agente](command:abapNavigator.ia.conectarAgente)",
            "media": {
              "image": "media/tutorial/07-agente-propuesta.png",
              "altText": "Propuesta del agente en un diff con los botones Aplicar y Rechazar"
            },
            "completionEvents": [
              "onCommand:abapNavigator.ia.conectarAgente"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && pnpm run compile:puente",
    "compile:puente": "node out/scripts/compilar-puente.js",
    "watch": "tsc -watch -p .",
    "lint": "eslint --no-error-on-unmatched-pattern src test scripts",
    "test:unit": "mocha \"out/test/unit/**/*.test.js\"",
    "test:integracion": "node out/test/run-tests.js",
    "test": "pnpm run compile && pnpm run test:unit && pnpm run test:integracion",
    "icono": "node out/scripts/generar-icono.js",
    "verificar:paquete": "node out/scripts/verificar-paquete.js",
    "package": "pnpm run verificar:paquete && vsce package --no-dependencies",
    "publish": "pnpm run verificar:paquete && vsce publish --no-dependencies"
  },
