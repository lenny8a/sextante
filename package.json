    "menus": {
      "view/title": [
        {
          "command": "abapNavigator.sistemas.refrescar",
          "when": "view == abapNavigator.sistemas",
          "group": "navigation@0"
        },
        {
          "command": "abapNavigator.sistemas.nuevo",
          "when": "view == abapNavigator.sistemas",
          "group": "navigation@1"
        },
        {
          "command": "abapNavigator.sistemas.editarDestinos",
          "when": "view == abapNavigator.sistemas",
          "group": "navigation@2"
        },
        {
          "command": "abapNavigator.objeto.refrescar",
          "when": "view == abapNavigator.objeto",
          "group": "navigation@90"
        },
        {
          "command": "abapNavigator.objeto.fijar",
          "when": "view == abapNavigator.objeto && !abapNavigator.objetoFijado",
          "group": "navigation@91"
        },
        {
          "command": "abapNavigator.objeto.soltar",
          "when": "view == abapNavigator.objeto && abapNavigator.objetoFijado",
          "group": "navigation@92"
        },
        {
          "command": "abapNavigator.objeto.modoBloque.activar",
          "when": "view == abapNavigator.objeto && !abapNavigator.objetoModoBloque",
          "group": "navigation@93"
        },
        {
          "command": "abapNavigator.objeto.modoBloque.desactivar",
          "when": "view == abapNavigator.objeto && abapNavigator.objetoModoBloque",
          "group": "navigation@94"
        },
        {
          "command": "abapNavigator.objeto.diario",
          "when": "view == abapNavigator.objeto && abapNavigator.objetoAbierto",
          "group": "navigation@95"
        },
        {
          "command": "abapNavigator.buscar",
          "when": "view == abapNavigator.objeto",
          "group": "navigation@0"
        },
        {
          "command": "abapNavigator.buscar",
          "when": "view == abapNavigator.paquetes",
          "group": "navigation@0"
        },
        {
          "command": "abapNavigator.paquetes.ir",
          "when": "view == abapNavigator.paquetes",
          "group": "navigation@0"
        },
        {
          "command": "abapNavigator.sql.consola",
          "when": "view == abapNavigator.objeto",
          "group": "navigation@1"
        },
        {
          "command": "abapNavigator.sql.consola",
          "when": "view == abapNavigator.paquetes",
          "group": "navigation@1"
        },
        {
          "command": "abapNavigator.sql.verDatos",
          "when": "view == abapNavigator.objeto && abapNavigator.objetoTipo == tabla",
          "group": "navigation@2"
        },
        {
          "command": "abapNavigator.paquetes.refrescar",
          "when": "view == abapNavigator.paquetes",
          "group": "navigation@1"
        },
        {
          "command": "abapNavigator.crearObjeto",
          "when": "view == abapNavigator.paquetes",
          "group": "navigation@0"
        },
        {
          "command": "abapNavigator.diccionario.refrescar",
          "when": "view == abapNavigator.diccionario",
          "group": "navigation@0"
        },
        {
          "command": "abapNavigator.diccionario.fijar",
          "when": "view == abapNavigator.diccionario && !abapNavigator.diccionario.fijado",
          "group": "navigation@1"
        },
        {
          "command": "abapNavigator.diccionario.soltar",
          "when": "view == abapNavigator.diccionario && abapNavigator.diccionario.fijado",
          "group": "navigation@1"
        },
        {
          "command": "abapNavigator.ordenes.refrescar",
          "when": "view == abapNavigator.ordenes",
          "group": "navigation@0"
