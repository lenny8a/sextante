{
  "name": "sextante",
  "displayName": "Sextante",
  "description": "SE80-style workbench inside VS Code on top of SAP ABAP Development Tools: systems, object search, object tree, one-click actions, dictionary in context and an AI agent over MCP.",
  "publisher": "lenny",
  "version": "0.1.1",
  "preview": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lenny8a/sextante.git"
  },
  "homepage": "https://github.com/lenny8a/sextante#readme",
  "bugs": {
    "url": "https://github.com/lenny8a/sextante/issues"
  },
  "icon": "media/sextante.png",
  "galleryBanner": {
    "color": "#282c34",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ABAP",
    "SAP",
    "ADT",
    "S/4HANA",
    "SE80"
  ],
  "activationEvents": [
    "onFileSystem:abap",
    "onFileSystem:abap-navigator-bloque",
