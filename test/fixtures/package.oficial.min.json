{
  "name": "adt-vscode",
  "version": "9.9.9",
  "publisher": "SAPSE",
  "activationEvents": ["onFileSystem:abap"],
  "contributes": {
    "commands": [
      { "command": "adt-vscode.activate", "title": "Activar objeto" },
      { "command": "adt-vscode.checkObject", "title": "Verificar objeto" }
    ],
    "viewsContainers": { "activitybar": [{ "id": "adt", "title": "ABAP" }] },
    "views": { "adt": [{ "id": "adt.repoTree", "name": "Repositorio" }] },
    "configuration": { "properties": { "adt.enableCommunicationLog": { "type": "boolean" } } },
    "resourceLabelFormatters": [{ "scheme": "abap" }]
  }
}
